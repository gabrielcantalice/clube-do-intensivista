# Copie este arquivo para ".env" na Vercel (nunca no navegador/cliente) e preencha
# com os valores reais do seu projeto Supabase e da Hotmart.
# No painel da Vercel: Project Settings > Environment Variables.

# Supabase (Project Settings > API no painel do Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key
# A chave "anon" (pública) fica no código do site nas páginas que passarem a usar
# login (não incluída ainda neste protótipo — adicionamos quando ligarmos o login).
SUPABASE_ANON_KEY=coloque-aqui-a-anon-key

# Hotmart — o "Hottok" é o token secreto que você define ao cadastrar o Webhook
# no painel da Hotmart. Usado para confirmar que a chamada realmente veio de lá.
HOTMART_HOTTOK=coloque-aqui-o-token-do-webhook-da-hotmart
